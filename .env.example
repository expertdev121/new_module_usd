# ─────────────────────────────────────────────────────────────────────────────
# DonorHQ — environment configuration template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (local dev) and set the same values in Vercel
# Project Settings → Environment Variables for production.
#
# When changing the production domain (e.g. switching from vercel preview
# URL to donorhq.givesuite.com), update ALL of the *_URL vars below
# atomically — they must all agree on the canonical host.

# ── Canonical app URL ────────────────────────────────────────────────────────
# Single source of truth used by lib/config/app-url.ts. Receipts, year-end
# letters, the OAuth callback, and the install entry all derive from this.
#
# Production:  https://donorhq.givesuite.com
# Local dev:   http://localhost:3000
NEXT_PUBLIC_APP_URL=https://donorhq.givesuite.com

# NextAuth requires this matches the canonical URL (used to mint session
# cookies + check callback URLs).
NEXTAUTH_URL=https://donorhq.givesuite.com

# Optional — only set this if you want a separate canonical URL for
# server-side links (rare; defaults to NEXT_PUBLIC_APP_URL).
# NEXT_PUBLIC_BASE_URL=https://donorhq.givesuite.com

# Session signing key. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=__set_in_vercel__

# ── GHL OAuth + webhooks ─────────────────────────────────────────────────────
# Must match what's configured in the GHL Marketplace App dashboard.
GHL_REDIRECT_URI=https://donorhq.givesuite.com/api/oauth/callback
GHL_INSTALL_URL=https://donorhq.givesuite.com/api/oauth/install
NEXT_PUBLIC_GHL_INSTALL_URL=https://donorhq.givesuite.com/api/oauth/install

# GHL API hosts (rarely change).
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_MARKETPLACE_BASE_URL=https://marketplace.gohighlevel.com
GHL_API_VERSION=2021-07-28

# Marketplace App credentials.
GHL_APP_ID=__from_ghl_marketplace__
GHL_APP_SSO_KEY=__from_ghl_marketplace__
GHL_SCOPES="contacts.readonly contacts.write tags.readonly tags.write payments/transactions.readonly invoices.readonly oauth.write oauth.readonly"

# Optional — webhook loop-prevention window. Default 30s; tune only if
# GHL's echo round-trip changes.
# GHL_WEBHOOK_LOOP_PREVENTION_WINDOW_SECONDS=30

# Outbound GHL webhook URL (the URL we POST to GHL workflows). This is a
# GHL service URL, not our domain — never set it to donorhq.givesuite.com.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/<yours>

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://...

# ── Vercel cron auth ─────────────────────────────────────────────────────────
# Auto-injected on Vercel Pro; set explicitly only for staging clones.
# CRON_SECRET=__auto_set_by_vercel__

# ── Stripe (legacy donation receipts) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
CMN_STRIPE_SECRET_KEY=sk_live_...
CMN_STRIPE_PUBLISHABLE_KEY=pk_live_...
CMN_STRIPE_WEBHOOK_SECRET=whsec_...

# ── Crowded (bankingcrowded.com) integration ────────────────────────────────
# 32 bytes of entropy used to encrypt Crowded API keys + webhook secrets at
# rest. Generate with: openssl rand -base64 32 (44-char base64 string).
# REQUIRED for Crowded to work; without it the lib throws on first call.
CROWDED_ENC_KEY=__generate_with_openssl_rand__

# Crowded API base — override only for sandbox / non-prod environments.
# CROWDED_API_BASE_URL=https://api.bankingcrowded.com

# ── Exchange rates ───────────────────────────────────────────────────────────
NEXT_PUBLIC_EXCHANGERATE_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_URL=/dashboard
NEXT_PUBLIC_SUPPORT_EMAIL=support@givesuite.com

# Trial settings.
FREE_TRIAL_DAYS=14
FREE_TRIAL_GRACE_DAYS=7
FREE_TRIAL_DELETION_RETENTION_DAYS=30
