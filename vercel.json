{
  "build": {
    "env": {
      "NPM_CONFIG_OPTIONAL": "true"
    }
  },
  "crons": [
    {
      "path": "/api/admin/backfill/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ghl-token-refresh-cron",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "app/api/admin/backfill/cron/route.ts": {
      "maxDuration": 300
    },
    "app/api/ghl-token-refresh-cron/route.ts": {
      "maxDuration": 300
    },
    "app/api/admin/backfill/trigger/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/offboard/[locationId]/export/route.ts": {
      "maxDuration": 120
    },
    "app/api/admin/offboard/[locationId]/hard-delete/route.ts": {
      "maxDuration": 120
    }
  }
}
